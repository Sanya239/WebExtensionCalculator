{
  "name": "WebCalc",
  "description": "Web Calculator with powerful Rust backend",
  "version": "1.4",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_title": "Calculator"
  },
  "icons": {
    "16": "img.png",
    "48": "img.png",
    "128": "img.png"
  },

  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "commands": {
    "Calculate with extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Calculate with extension"
    }
  }
}
